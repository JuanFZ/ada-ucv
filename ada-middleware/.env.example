# Seguridad entre Moodle y Middleware
ADA_SERVICE_TOKEN=cambia-este-token-secreto-local

# Proveedor primario y fallback ('groq' o 'gemini')
ADA_PRIMARY_PROVIDER=groq
ADA_FALLBACK_PROVIDER=gemini

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parámetros operativos
ADA_TIMEOUT_SECONDS=30
ADA_MAX_RETRIES=1

