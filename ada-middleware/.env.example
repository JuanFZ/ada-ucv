# Seguridad entre Moodle y Middleware
ADA_SERVICE_TOKEN=cambia-este-token-secreto-local

# Proveedor primario y fallback ('gemini', 'openrouter', 'sambanova', 'mistral' o 'groq')
ADA_PRIMARY_PROVIDER=gemini
ADA_FALLBACK_PROVIDER=openrouter

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter API (https://openrouter.ai/settings/keys) [modelos :free, sin tarjeta]
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# SambaNova Cloud API (https://cloud.sambanova.ai/apis) [sin bloqueo en Venezuela]
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Mistral AI - La Plateforme (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq API (opcional; puede requerir VPN/proxy en Venezuela)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Parámetros operativos
ADA_TIMEOUT_SECONDS=30
ADA_MAX_RETRIES=1
