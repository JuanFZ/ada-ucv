# Seguridad entre Moodle y Middleware
ADA_SERVICE_TOKEN=cambia-este-token-secreto-local

# Proveedor primario y fallback ('mistral', 'gemini' o 'groq')
ADA_PRIMARY_PROVIDER=mistral
ADA_FALLBACK_PROVIDER=gemini

# Mistral AI - La Plateforme (https://console.mistral.ai/api-keys) [UE, sin bloqueo en Venezuela]
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API (opcional; puede requerir VPN/proxy en Venezuela)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Parámetros operativos
ADA_TIMEOUT_SECONDS=30
ADA_MAX_RETRIES=1
